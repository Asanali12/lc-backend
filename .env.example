# Copy to .env for local dev. None of these are required to run locally —
# defaults are tuned for "just `python manage.py runserver` and go".

# Required for any non-local deployment: write endpoints reject requests
# whose Authorization: Bearer <token> header doesn't match this value.
LC_BACKEND_WRITE_TOKEN=

# Django essentials. Override for prod.
DJANGO_SECRET_KEY=django-insecure-hackathon-only-change-me-in-prod
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# S3 storage (optional). When AWS_BUCKET is set the backend stores html /
# events.json blobs in S3 instead of the local ./storage/ folder. Reuse the
# funnel's bucket — the prefix LC_S3_PREFIX (default "lc-pages") keeps blobs
# isolated from the funnel's existing keys.
AWS_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LC_S3_PREFIX=lc-pages
